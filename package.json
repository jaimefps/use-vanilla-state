{
  "version": "1.0.0-alpha.0",
  "name": "use-vanilla-state",
  "description": "Manage React component state using plain JavaScript classes",
  "author": "jaimefps (https://github.com/jaimefps)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/jaimefps/use-vanilla-state"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/jaimefps/use-vanilla-state",
  "bugs": {
    "url": "https://github.com/jaimefps/use-vanilla-state/issues"
  },
  "keywords": [
    "state",
    "react-hook",
    "react"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "cypress": "^13.16.0",
    "jsdom": "^26.1.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "cypress:run": "cypress run",
    "playwright:run": "playwright test",
    "prep": "npm run clean && npm run build && npm test",
    "pub": "npm run prep && npm publish"
  }
}
